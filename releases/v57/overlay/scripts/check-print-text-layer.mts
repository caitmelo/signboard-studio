import fs from 'node:fs';import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';import {PDFDocument,PDFArray,PDFRawStream,decodePDFRawStream} from 'pdf-lib';import {detachPrintText,attachPrintText} from '../lib/print-text-layer';
const input=new Uint8Array(fs.readFileSync('work/stone-qa/listed-pre-final.pdf'));
const {background,layers}=await detachPrintText(input);assert(layers.length===2&&layers.every(x=>x.length===1));fs.writeFileSync('work/stone-qa/detached.pdf',background);
execFileSync('gs',['-q','-sDEVICE=pdfwrite','-dCompatibilityLevel=1.3','-dNoOutputFonts','-dBATCH','-dNOPAUSE','-sOutputFile=work/stone-qa/converted.pdf','work/stone-qa/detached.pdf']);
const final=await attachPrintText(new Uint8Array(fs.readFileSync('work/stone-qa/converted.pdf')),layers,'1.3');assert(new TextDecoder().decode(final.slice(0,8))==='%PDF-1.3');
const doc=await PDFDocument.load(final);for(const[i,page]of doc.getPages().entries()){const arr=page.node.Contents() as PDFArray;const raw=arr.asArray().map(ref=>{const stream=doc.context.lookup(ref) as PDFRawStream;return new TextDecoder().decode(decodePDFRawStream(stream).decode());}).join('\n');for(const layer of layers[i])assert(raw.includes(new TextDecoder().decode(layer)));}fs.writeFileSync('work/stone-qa/browser-vector-print.pdf',final);console.log('PASS browser detach/convert/attach path keeps exact vector text in PDF 1.3');
