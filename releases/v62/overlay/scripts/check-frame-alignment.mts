import fs from 'node:fs';import assert from 'node:assert/strict';
import {normalizeSavedTemplate} from '../lib/print-specs';
import {evaluateTemplate,renderTemplate,loadEngineAssets} from '../lib/template-engine';
import {defaultRichText} from '../lib/rich-text';
import {resolveContent,groupRuns} from '../lib/content-groups';
import {addMissingTemplateBleed} from '../lib/missing-bleed';
import {PDFDocument} from 'pdf-lib';
const root=process.env.TEMPLATE_FIXTURES;if(!root)throw Error('Set TEMPLATE_FIXTURES to the original template fixture directory');
globalThis.fetch=async(input:any)=>{const p='public'+new URL(String(input),'https://test').pathname;return fs.existsSync(p)?new Response(fs.readFileSync(p)):new Response('',{status:404});};
const assets=await loadEngineAssets();
const brochure=normalizeSavedTemplate(JSON.parse(fs.readFileSync(root+'/brochure-manifest.json','utf8'))),page=brochure.pages![0];
const name=page.fields.find(f=>f.role==='agent1_name')!,phone=page.fields.find(f=>f.role==='agent1_phone')!;
const old=evaluateTemplate(page,{},false);const changed=evaluateTemplate(page,{[name.id]:'Quinn Sample'},false);
assert.deepEqual(changed.errors,[]);const a=changed.fields.find(f=>f.id===name.id),b=changed.fields.find(f=>f.id===phone.id);
assert.equal(a.x,name.x);assert.equal(b.y,phone.y);assert.ok(b.x<phone.x-20,'phone must follow shorter name instead of leaving a fixed gap');
assert.ok(Math.abs(old.fields.find(f=>f.id===phone.id).x-phone.x)<.00001,'unchanged phone must not move');
const group=page.groups!.find(g=>g.label==='Property details')!;assert.ok(group);assert.ok(group.fieldIds.length>50);
const rich=defaultRichText(group,groupRuns(group,page.fields));assert.ok(rich.text.includes('\n• Four spacious'));
const original=resolveContent(page,{}, {[group.key]:rich});assert.equal(original.template.fields.length,page.fields.length);assert.deepEqual(original.template.fields,page.fields,'unchanged rich text retains exact glyph positions');
const short={rich:true as const,text:'Lovely home\n• Three bedrooms\n• Sunny living',styles:[]};
const edited=evaluateTemplate(page,{},false,{[group.key]:short});assert.deepEqual(edited.errors,[]);
fs.writeFileSync(root+'/brochure-normalized.json',JSON.stringify(brochure));fs.writeFileSync(root+'/brochure-job.json',JSON.stringify({text:{[name.id]:'Quinn Sample'},content:{[group.key]:short},mode:'proof'}));
fs.writeFileSync(root+'/brochure-fixed.pdf',await renderTemplate(fs.readFileSync(root+'/brochure-base.pdf'),brochure,{[name.id]:'Quinn Sample'},false,assets,{}, {[group.key]:short}));
const sign=normalizeSavedTemplate(JSON.parse(fs.readFileSync(root+'/signboard-manifest.json','utf8')));
const email=sign.fields.find(f=>f.text==='vedant@tagre.au')!;assert.equal(email.align,'center');
const adjusted=evaluateTemplate(sign,{[email.id]:'ted@data.au'},false);const e=adjusted.fields.find(f=>f.id===email.id);assert.ok(Math.abs(e.x+e.width/2-email.x-email.width/2)<.001);
const base=fs.readFileSync(root+'/signboard-base.pdf');const generated=await addMissingTemplateBleed(base,sign);assert.equal(generated.template.spec.sourceIncludesBleed,true);
const doc=await PDFDocument.load(generated.base),trim=doc.getPage(0).getTrimBox();assert.ok(Math.abs(trim.width-sign.sourceWidth)<.001);assert.ok(Math.abs(trim.height-sign.sourceHeight)<.001);
const second=await addMissingTemplateBleed(generated.base,generated.template);assert.equal(second.base,generated.base,'bleed must not be added twice');
fs.writeFileSync(root+'/signboard-auto-bleed-base.pdf',generated.base);fs.writeFileSync(root+'/signboard-auto-bleed.json',JSON.stringify(generated.template));
console.log('PASS: source anchors, inline phone flow, centred email, unified list frame, unchanged glyph positions, exact trim and idempotent bleed');
