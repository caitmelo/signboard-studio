import assert from 'node:assert/strict';
import fs from 'node:fs';
import {fontNeedsChoice,missingFonts,closestFont,acceptAlternative,applyTemplateFont} from '../lib/font-choices';
import {fontFromFile} from '../lib/template-engine';
import {withFreeFallback} from '../lib/free-fonts';
import {resolveInstalledFonts} from '../lib/installed-fonts';
import {PUT as install} from '../app/api/fonts/installed/route';
import {POST as choose} from '../app/api/templates/[id]/fonts/route';
import {POST as complete} from '../app/api/templates/[id]/complete/route';
import {POST as createPackage} from '../app/api/packages/route';
import {PUT as packageFile} from '../app/api/packages/[id]/files/[fileId]/route';
import {env} from './test-storage-env.mjs';
import type {FontData,SavedTemplate} from '../lib/template-types';
const name='HelveticaNeueLTStd-Bd';
const original:FontData={name,unitsPerEm:1000,source:'embedded',subset:true,glyphs:{65:{advance:611,path:'0 0 m 500 0 l 250 700 l h',bounds:[0,0,500,700]}}};
assert.equal(closestFont(name,original),'Arimo Bold');assert.equal(closestFont('SignPainterHouseScript'),'Yellowtail');assert.equal(closestFont('EOS-Icons-PBGeneric'),'Noto Sans Symbols 2');assert.equal(closestFont('Unknown Serif Bold'),'NimbusRomNo9L-Med');assert.equal(closestFont('Unknown Sans Italic'),'Arimo Italic');
assert(fontNeedsChoice(undefined));assert(fontNeedsChoice(original));assert(fontNeedsChoice(withFreeFallback(name,original)));assert(!fontNeedsChoice({...original,source:'upload',subset:false}));
const accepted=acceptAlternative(name,original);assert(!fontNeedsChoice(accepted));assert.equal(accepted.choice?.replacement,'Arimo Bold');assert.deepEqual(accepted.glyphs['65'],original.glyphs['65']);for(const c of '!?Z')assert(accepted.glyphs[c.codePointAt(0)!]);assert.equal(accepted.unitsPerEm,original.unitsPerEm);assert(!acceptAlternative('EOS-Icons-PBGeneric').glyphs['57344']);
const field={id:'heading',fontName:name,text:'A',x:10,y:10,width:20,size:12,role:'custom',color:[0,0,0,1],horizontalScale:1,charSpace:0,wordSpace:0,supported:true,encodingComplete:true,label:'Heading',stream:'page',opIndex:1} as const;
const manifest={schemaVersion:1,name:'Font test',sourceName:'Font test.pdf',sourceWidth:210,sourceHeight:297,spec:{faceWidth:210,faceHeight:297,bleed:2,sourceIncludesBleed:false,marks:false},fields:[field],fonts:{[name]:original},warnings:[],printIssues:[],createdAt:new Date().toISOString()} as unknown as SavedTemplate;
assert.equal(missingFonts([manifest,manifest]).length,1);assert.deepEqual(missingFonts([manifest,manifest])[0].pages,[1,2]);assert.equal(resolveInstalledFonts(manifest).fonts[name].fallbackName,undefined,'no silent free substitution');
const otherPage={...manifest,fonts:{[name]:{...original,glyphs:{66:{advance:612,path:'0 0 m 1 1 l',bounds:[0,0,1,1]}}}}};const updated=applyTemplateFont({...manifest,pages:[manifest,otherPage]},name,f=>acceptAlternative(name,f));assert.deepEqual(updated.pages![1].fonts[name].glyphs['66'],otherPage.fonts[name].glyphs['66']);assert.deepEqual(updated.fields,manifest.fields);assert.deepEqual(updated.spec,manifest.spec);assert.equal(missingFonts(updated.pages!).length,0);
const request=(url:string,method='POST',body?:BodyInit,user='owner',headers:Record<string,string>={})=>new Request('https://example.test'+url,{method,body,headers:{'oai-authenticated-user-id':user,...headers}});
const bytes=fs.readFileSync('public/pdfjs/standard_fonts/LiberationSans-Regular.ttf'),full=fontFromFile(bytes),uploadURL='/api/fonts/installed?name='+encodeURIComponent(full.name);
assert.equal((await install(request(uploadURL,'PUT',bytes))).status,422);
assert.equal((await install(request(uploadURL,'PUT',bytes,'owner',{'X-Font-License-Confirmed':'true'}))).status,200);
const id=crypto.randomUUID(),ctx={params:Promise.resolve({id})};await env.DB.prepare("INSERT INTO sign_templates(id,owner_id,name,source_name,status,created_at) VALUES(?,?,'Test','Test.pdf','draft',?)").bind(id,'owner',new Date().toISOString()).run();
for(const key of ['source','base','thumbnail'])await env.BUCKET.put(`templates/${id}/${key}`,'test');await env.BUCKET.put(`templates/${id}/manifest`,JSON.stringify(manifest),{customMetadata:{revision:'3'}});
assert.equal((await complete(request('/api/templates/'+id+'/complete'),ctx)).status,422,'saving unresolved fonts must fail');
await env.DB.prepare("UPDATE sign_templates SET status='ready' WHERE id=?").bind(id).run();
const choice={name,kind:'alternative',replacement:'Arimo Bold'};
assert.equal((await choose(request('/font','POST',JSON.stringify(choice),'outsider'),ctx)).status,404);
assert.equal((await choose(request('/font','POST',JSON.stringify(choice),'owner',{origin:'https://other.test'}),ctx)).status,403);
assert.equal((await choose(request('/font','POST',JSON.stringify({...choice,replacement:'Unknown'})),ctx)).status,409);
assert.equal((await choose(request('/font','POST',JSON.stringify(choice)),ctx)).status,200);
let saved=await(await env.BUCKET.get(`templates/${id}/manifest`))!.json() as SavedTemplate;assert.equal(saved.fonts[name].choice?.kind,'alternative');assert.equal(missingFonts([saved]).length,0);assert.deepEqual(saved.fields,manifest.fields);assert.equal((await env.BUCKET.get(`templates/${id}/manifest`))?.customMetadata.revision,'3');
// Full matching upload is checked against the actual font family and licensed storage.
const uploadManifest={...manifest,fields:[{...field,fontName:full.name}],fonts:{[full.name]:{...full,subset:true}}};await env.BUCKET.put(`templates/${id}/manifest`,JSON.stringify(uploadManifest));
assert.equal((await choose(request('/font','POST',JSON.stringify({name:full.name,kind:'upload'})),ctx)).status,200);saved=await(await env.BUCKET.get(`templates/${id}/manifest`))!.json();assert.equal(saved.fonts[full.name].choice?.licenseConfirmed,true);
const pack=await(await createPackage(request('/api/packages','POST',JSON.stringify({name:'Package fonts'})))).json() as {id:string};const pc={params:Promise.resolve({id:pack.id,fileId:crypto.randomUUID()})};
assert.equal((await packageFile(request('/package','PUT',bytes,'owner',{'X-Package-Path':'Document%20fonts%2Ffont.ttf'}),pc)).status,422);
assert.equal((await packageFile(request('/package','PUT',bytes,'owner',{'X-Package-Path':'Document%20fonts%2Ffont.ttf','X-Font-License-Confirmed':'true'}),pc)).status,200);
console.log('PASS missing-font detection, explicit alternatives/styles, original glyph/position preservation, per-page choices, licensed uploads, server save gate, private persisted choices and package licence checks.');
